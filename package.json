{
  "name": "le-mans-ultimate-setups",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test tests/*.test.mjs",
    "test:python": "python3 -B -m unittest discover -s tests -p \"test_*.py\" && python3 -B -m unittest discover -s .github/changelog -p \"test_*.py\"",
    "check:deploy": "node tools/predeploy-check.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,html,css}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@html-eslint/eslint-plugin": "0.67.0",
    "@html-eslint/parser": "0.67.0",
    "eslint": "10.13.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
